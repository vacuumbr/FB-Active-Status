{
  "name": "fb-active-status",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Blocks Facebook's realtime WebSocket connections to show the last active time instead of \"Active now\".",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:css": "node node_modules/@tailwindcss/cli/dist/index.mjs -i src/popup.css -o public/popup.css --minify",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/extension.test.mjs tests/popupTypes.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/chrome": "0.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "lucide": "^1.47.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
